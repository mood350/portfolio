---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import { logo } from "../icons";
import { me, stack, projects, services, experience, consoleErrors } from "../data";
const shown = projects.slice(0, 6);
---
<html lang="fr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{me.name} — {me.role}</title>
  <meta name="description" content={me.tagline} />
  <style is:global>
    :root{--paper:#fff;--ink:#151515;--soft:#262626;--line:#e8e8e6;--mist:#f5f5f4;--muted:#6b6b6b;--acc:#d9653b;--ok:#3fb56b;--code:#0f0f10;--codeline:#26262a;--panel:#161618}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}
    body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 "Manrope Variable",system-ui,sans-serif}
    .mono{font-family:"JetBrains Mono Variable",ui-monospace,monospace}
    a{color:inherit}
    .wrap{max-width:1180px;margin:auto;padding:0 5vw}
    section{padding:6rem 0}
    #bar{position:fixed;top:0;left:0;height:3px;width:100%;background:var(--acc);transform-origin:0 50%;transform:scaleX(0);z-index:50}
    #cur{position:fixed;top:0;left:0;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:var(--acc);mix-blend-mode:multiply;pointer-events:none;z-index:60;display:none}
    @media(pointer:fine){#cur{display:block}}
    .ch1{display:inline-block;will-change:transform}
    .card{transform-style:preserve-3d;will-change:transform}
    /* nav */
    nav{position:fixed;top:12px;left:0;right:0;margin:0 auto;width:fit-content;max-width:calc(100% - 24px);z-index:20;background:#ffffffcc;backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:999px;box-shadow:0 10px 30px #00000018}
    nav .wrap{display:flex;align-items:center;height:52px;max-width:none;margin:0;padding:0 .4rem 0 1.1rem;justify-content:center;gap:1.5rem}
    .links{display:flex;gap:1.5rem;font-size:1.02rem;font-weight:500}.links a{text-decoration:none;color:var(--muted)}.links a:hover{color:var(--ink)}
    .links sup{font:.72rem "JetBrains Mono Variable",monospace;color:var(--acc);margin-left:.15rem}
    nav .btn{padding:.5rem 1.15rem;font-size:.98rem}
    .btn{display:inline-block;background:var(--ink);color:#fff;border:1px solid var(--ink);padding:.7rem 1.3rem;border-radius:999px;text-decoration:none;font-weight:700;font-size:.9rem;cursor:pointer;transition:background .2s,border-color .2s;font-family:inherit}
    .btn:hover{background:var(--acc);border-color:var(--acc);transform:translateY(-2px)}
    .btn.ghost{background:none;color:var(--ink)}.btn.ghost:hover{color:#fff}
    @media(max-width:760px){.links{display:none}}
    /* hero */
    .hero{display:grid;grid-template-columns:1.3fr 1fr;gap:3rem;align-items:center;padding-top:8rem;padding-bottom:3.5rem}
    .eyebrow{font-size:.8rem;color:var(--muted);letter-spacing:.3em}
    .name{position:relative;font-size:clamp(2.2rem,6vw,4.6rem);line-height:1.02;font-weight:800;letter-spacing:-.04em;margin:1rem 0;display:inline-block}
    .name .w{display:inline-block;white-space:nowrap}
    .name::before,.name::after{content:attr(data-text);position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;clip-path:inset(0 0 100% 0)}
    .name::before{color:var(--acc);animation:gl1 3.6s steps(1) 2.6s infinite}
    .name::after{color:#18b8c9;animation:gl2 3.6s steps(1) 2.6s infinite}
    @keyframes gl1{0%,86%,100%{clip-path:inset(0 0 100% 0);transform:none}87%{clip-path:inset(15% 0 55% 0);transform:translate(-6px,0)}90%{clip-path:inset(60% 0 10% 0);transform:translate(5px,0)}93%{clip-path:inset(35% 0 40% 0);transform:translate(-3px,0)}96%{clip-path:inset(0 0 85% 0);transform:translate(4px,0)}}
    @keyframes gl2{0%,86%,100%{clip-path:inset(0 0 100% 0);transform:none}88%{clip-path:inset(50% 0 20% 0);transform:translate(6px,0)}91%{clip-path:inset(10% 0 70% 0);transform:translate(-5px,0)}94%{clip-path:inset(70% 0 5% 0);transform:translate(3px,0)}97%{clip-path:inset(25% 0 50% 0);transform:translate(-4px,0)}}
    .role{font-size:1.5rem;font-weight:700;color:var(--acc);margin:0}
    .hero p.t{color:var(--muted);font-size:1.1rem;max-width:34rem}
    .cta-row{display:flex;gap:.8rem;flex-wrap:wrap;margin:1.5rem 0}
    .photo{position:relative;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 30% 30%,#ffd9c9,var(--acc));display:grid;place-items:center;font:800 5rem "Manrope Variable";color:#fff;max-width:380px;justify-self:center;width:100%}
    .photo::before{content:"";position:absolute;inset:-14px;border:1px dashed var(--ink);border-radius:50%;animation:spin 18s linear infinite}
    .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:45% 30%;border-radius:50%}
    @keyframes spin{to{transform:rotate(360deg)}}
    @media(max-width:860px){
      .hero{grid-template-columns:1fr;text-align:center;padding-top:6.5rem;padding-bottom:2.5rem;gap:2.2rem}
      .photo{order:-1;max-width:min(62vw,250px)}
      .name{display:block;font-size:clamp(2.1rem,10.5vw,4rem)}
      .role{font-size:1.25rem}
      .hero p.t{margin-inline:auto;font-size:1.02rem}
      .cta-row{justify-content:center}
    }
    @media(max-width:600px){.eyebrow{font-size:.62rem;letter-spacing:0}}
    /* marquee */
    .marq{overflow:hidden;border-block:1px solid var(--codeline);background:var(--code);padding:1.1rem 0}
    .track{display:flex;gap:3.5rem;width:max-content;animation:marquee 40s linear infinite;font-weight:700;color:#fff}
    .tech{display:flex;align-items:center;gap:.7rem;white-space:nowrap}
    .marq:hover .track{animation-play-state:paused}
    @keyframes marquee{to{transform:translateX(-50%)}}
    /* headings */
    h2.s{font:700 .85rem "JetBrains Mono Variable",monospace;letter-spacing:.12em;color:var(--acc);margin:0 0 .6rem}
    h3.big{font-size:clamp(2rem,5vw,3.2rem);line-height:1.1;letter-spacing:-.03em;margin:0 0 2rem}
    /* projects */
    .filters{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:2rem;align-items:center}
    .filters button{background:none;border:1px solid var(--line);padding:.45rem 1rem;border-radius:999px;font:600 .85rem inherit;font-family:inherit;cursor:pointer;color:var(--muted)}
    .filters button.on{background:var(--ink);color:#fff;border-color:var(--ink)}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:1.2rem}
    .card{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;transition:box-shadow .25s,border-color .25s;display:flex;flex-direction:column}
    .card:hover{transform:translateY(-6px);box-shadow:0 18px 40px #0000001a;border-color:var(--ink)}
    .card[hidden]{display:none}
    .thumb{aspect-ratio:16/9;background:linear-gradient(135deg,#1b1b1f,var(--code));position:relative;overflow:hidden;display:grid;place-items:center}
    .thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .6s}
    .card:hover .thumb img{transform:scale(1.05)}
    .thumb b{font:800 5rem "Manrope Variable";color:#ffffff22}
    .body{padding:1.3rem;display:flex;flex-direction:column;gap:.6rem;flex:1}
    .kind{font:700 .68rem "JetBrains Mono Variable",monospace;letter-spacing:.1em;color:var(--acc);text-transform:uppercase}
    .card h4{margin:0;font-size:1.3rem}.card p{margin:0;color:var(--muted);font-size:.93rem;flex:1}
    .tags{display:flex;flex-wrap:wrap;gap:.4rem}.tags span{font-size:.72rem;background:var(--mist);padding:.2rem .65rem;border-radius:999px}
    .lk{display:flex;gap:1rem;font-weight:700;font-size:.85rem}.lk a{color:var(--acc);text-decoration:none}
    /* services */
    .acc{border-top:1px solid var(--line)}
    .acc .sv{border-bottom:1px solid var(--line);padding:1.3rem 0;outline:none;cursor:pointer}
    .acc .sh{display:flex;align-items:center;font-size:1.5rem;font-weight:700;transition:color .3s,padding .3s}
    .acc .sh span{flex:1}
    .acc .sh small{font:.75rem "JetBrains Mono Variable",monospace;color:var(--muted);margin-right:1rem}
    .acc .sh::after{content:"+";font:400 1.8rem "JetBrains Mono Variable",monospace;color:var(--acc);transition:transform .3s}
    .acc .sb{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s ease}
    .acc .sb p{overflow:hidden;min-height:0;margin:0;color:var(--muted);max-width:40rem}
    .acc .sv:focus .sb{grid-template-rows:1fr}.acc .sv:focus .sb p{margin-top:.8rem}.acc .sv:focus .sh::after{transform:rotate(45deg)}
    @media(hover:hover){.acc .sv:hover .sb{grid-template-rows:1fr}.acc .sv:hover .sb p{margin-top:.8rem}.acc .sv:hover .sh{color:var(--acc);padding-left:.6rem}.acc .sv:hover .sh::after{transform:rotate(45deg)}}
    /* experience */
    .tl{border-left:2px solid var(--line);margin-left:.4rem}
    .tl div{position:relative;padding:0 0 2rem 1.8rem}
    .tl div::before{content:"";position:absolute;left:-7px;top:.45rem;width:12px;height:12px;border-radius:50%;background:var(--paper);border:2px solid var(--acc)}
    .tl b{font-size:1.15rem;display:block}.tl span{color:var(--muted);font-size:.92rem}.tl em{display:block;font:.75rem "JetBrains Mono Variable";color:var(--acc);font-style:normal;margin-top:.2rem}
    /* console */
    .console{overflow:hidden;border-block:1px solid var(--codeline);background:#000;padding:.8rem 0;color:#ff6568;font:.8rem "JetBrains Mono Variable",monospace}
    .console .track{animation-duration:60s;color:#ff6568;font-weight:400}
    /* formulaire */
    .form{display:grid;gap:1.1rem;border:1px solid var(--line);border-radius:22px;padding:1.6rem;background:#fff}
    .form label{display:grid;gap:.4rem;font-weight:700;font-size:.9rem}
    .form input,.form select,.form textarea{font:500 1rem "Manrope Variable",system-ui,sans-serif;color:var(--ink);background:var(--mist);border:1px solid transparent;border-radius:12px;padding:.85rem 1rem;width:100%;transition:border-color .2s,background .2s}
    .form textarea{resize:vertical;min-height:130px}
    .form input:focus,.form select:focus,.form textarea:focus{outline:none;border-color:var(--acc);background:#fff}
    .form .btn{justify-self:start}
    #status{margin:0;font-size:.85rem;color:var(--muted);min-height:1.3em}
    .book{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
    @media(max-width:860px){.book{grid-template-columns:1fr}}
    @media(pointer:coarse){.lk a{padding:.7rem 0}.filters button{padding:.7rem 1.1rem}}
    footer{border-top:1px solid var(--line);padding:2rem 0;color:var(--muted);font-size:.85rem}
    footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
    @media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}html{scroll-behavior:auto}}
  </style>
</head>
<body>
  <div id="bar"></div><div id="cur"></div>
  <nav><div class="wrap">
    <div class="links">
      <a href="#projets">Projets<sup>[ {projects.length} ]</sup></a>
      <a href="#services">Services<sup>[ {services.length} ]</sup></a>
      <a href="#experience">Expérience</a>
      <a href="#contact">Contact</a>
    </div>
    <a class="btn" href="#formulaire">Parlons-en</a>
  </div></nav>

  <header class="wrap hero" id="top">
    <div class="reveal">
      <div class="eyebrow mono">{"BONJOUR, JE SUIS".split("").join(" ")}</div>
      <h1 class="name" data-text={me.name}>{me.name}</h1>
      <p class="role">{me.role}</p>
      <p class="t">{me.tagline}</p>
      <div class="cta-row"><a class="btn" href="#formulaire">Collaborons</a><a class="btn ghost" href={me.github}>GitHub ↗</a></div>
    </div>
    <div class="photo reveal"><img src={`${import.meta.env.BASE_URL}/profil.jpeg`} alt={`Portrait de ${me.name}`} width="800" height="1080" fetchpriority="high" /></div>
  </header>

  <div class="marq" aria-hidden="true"><div class="track">{[...stack, ...stack, ...stack, ...stack].map((n) => { const l = logo(n); return (
      <span class="tech">
        {l?.img && <img src={`${import.meta.env.BASE_URL}/${l.img}`} alt="" width="26" height="26" loading="lazy" />}
        {l?.path && <svg viewBox="0 0 24 24" width="26" height="26" fill={l.color} aria-hidden="true"><path d={l.path} /></svg>}
        {n}
      </span>); })}</div></div>

  <section id="projets"><div class="wrap">
    <h2 class="s">/PROJETS</h2><h3 class="big reveal">Choisis ce que tu veux voir</h3>
    <div class="filters" role="group" aria-label="Filtrer les projets">
      <button class="on" data-f="all">Tous</button><button data-f="real">Projets réels</button><button data-f="explo">Explorations</button>
      <button id="more" style="margin-left:auto;border-color:var(--ink);color:var(--ink)">Voir tout ({projects.length})</button>
    </div>
    <div class="grid">
      {projects.map((p, i) => (
        <article class="card reveal" data-k={p.kind} data-extra={i >= shown.length ? "1" : undefined} hidden={i >= shown.length}>
          <div class="thumb">
            {p.img ? <img src={`${import.meta.env.BASE_URL}/${p.img}`} alt={`Capture de la page d'accueil de ${p.title}`} width="960" height="540" loading="lazy" /> : <b>{p.title[0]}</b>}
          </div>
          <div class="body">
            <span class="kind">{p.kind === "real" ? "Projet réel" : "Exploration"}</span>
            <h4>{p.title}</h4><p>{p.desc}</p>
            <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
            <div class="lk">{p.demo && <a href={p.demo}>Démo ↗</a>}{p.repo && <a href={p.repo}>Code ↗</a>}</div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section id="services" style="background:var(--mist)"><div class="wrap">
    <h2 class="s">/SERVICES</h2><h3 class="big reveal">Ce que je peux faire pour toi</h3>
    <div class="acc">
      {services.map((s, i) => <div class="sv" tabindex="0"><div class="sh"><span>{s.t}</span><small>0{i + 1}</small></div><div class="sb"><p>{s.d}</p></div></div>)}
    </div>
  </div></section>

  <section id="experience"><div class="wrap">
    <h2 class="s">/EXPÉRIENCE</h2><h3 class="big reveal">Parcours</h3>
    <div class="tl">{experience.map((e) => <div><b>{e.role}</b><span>{e.org}</span><em>{e.date}</em></div>)}</div>
  </div></section>

  <div class="console mono" aria-hidden="true"><div class="track">{[...consoleErrors, ...consoleErrors, ...consoleErrors].map((e) => <span>✖ {e}</span>)}</div></div>

  <section id="formulaire"><div class="wrap book">
    <div>
      <h2 class="s">/FORMULAIRE</h2><h3 class="big reveal">Parlons de ton projet</h3>
      <p style="color:var(--muted);max-width:28rem">Décris ton besoin en quelques lignes. Le message s'ouvre dans ton application mail, prêt à être envoyé à {me.email}.</p>
    </div>
    <form class="form" id="form">
      <label>Nom<input name="nom" required maxlength="80" autocomplete="name" /></label>
      <label>Email<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
      <label>Type de projet
        <select name="type">{services.map((x) => <option>{x.t}</option>)}<option>Autre</option></select>
      </label>
      <label>Message<textarea name="msg" required rows="5" maxlength="1200"></textarea></label>
      <button class="btn" type="submit">Envoyer le message</button>
      <p id="status" role="status"></p>
    </form>
  </div></section>

  <section id="contact" style="background:var(--ink);color:#fff;text-align:center"><div class="wrap">
    <h2 class="s">/CONTACT</h2><h3 class="big">Un projet en tête ?</h3>
    <a class="btn" style="background:var(--acc);border-color:var(--acc)" href={`mailto:${me.email}`}>{me.email}</a>
  </div></section>
  <footer><div class="wrap"><span>© {new Date().getFullYear()} {me.name}</span><span class="mono">Codé avec Astro &amp; beaucoup de café</span></div></footer>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // intro: nom lettre par lettre, puis le reste du hero
      const name = document.querySelector<HTMLElement>(".name")!;
      const txt = name.textContent!.trim();
      name.innerHTML = txt.split(" ").map((w) => `<span class="w">${[...w].map((c) => `<span class="ch1">${c}</span>`).join("")}</span>`).join(" ");
      const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
      tl.from("nav", { yPercent: -150, autoAlpha: 0, duration: 0.8 });
      tl.from(".eyebrow", { y: 20, autoAlpha: 0, duration: 0.6 })
        .from(".ch1", { yPercent: 120, rotate: 12, autoAlpha: 0, stagger: 0.05, duration: 0.9 }, "-=0.3")
        .from(".role, .hero p.t, .cta-row", { y: 30, autoAlpha: 0, stagger: 0.12, duration: 0.8 }, "-=0.5")
        .from(".photo", { scale: 0.4, rotate: -90, autoAlpha: 0, duration: 1.2, ease: "elastic.out(1,0.6)" }, 0.3);

      // parallaxe de la photo au scroll + à la souris
      if (innerWidth > 860) gsap.to(".photo", { yPercent: 25, ease: "none", scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true } });
      const px = gsap.quickTo(".photo", "x", { duration: 0.6 }), py = gsap.quickTo(".photo", "rotation", { duration: 0.6 });
      if (fine) addEventListener("mousemove", (e) => { px((e.clientX / innerWidth - 0.5) * 30); py((e.clientX / innerWidth - 0.5) * 8); });

      // barre de progression
      gsap.to("#bar", { scaleX: 1, ease: "none", scrollTrigger: { scrub: 0.2, start: 0, end: "max" } });

      // apparition au scroll
      gsap.utils.toArray<HTMLElement>(".reveal:not(.card):not(.hero *)").forEach((el) =>
        gsap.from(el, { y: 60, autoAlpha: 0, duration: 1, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 88%" } }));
      gsap.from(".card", { y: 80, rotateX: -15, autoAlpha: 0, duration: 0.9, stagger: 0.1, ease: "power3.out", scrollTrigger: { trigger: ".grid", start: "top 85%" } });
      gsap.fromTo(".tl > div", { x: -50, autoAlpha: 0 }, { x: 0, autoAlpha: 1, stagger: 0.2, duration: 0.8, scrollTrigger: { trigger: ".tl", start: "top 85%", once: true } });
      gsap.fromTo(".acc .sv", { y: 40, autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.12, duration: 0.7, scrollTrigger: { trigger: ".acc", start: "top 85%", once: true } });
      gsap.utils.toArray<HTMLElement>(".thumb b").forEach((b) =>
        gsap.to(b, { yPercent: -60, ease: "none", scrollTrigger: { trigger: b, scrub: true } }));

      // bandeaux: défilement lié à la vitesse du scroll
      document.querySelectorAll<HTMLElement>(".track").forEach((t, i) => {
        const tw = gsap.to(t, { xPercent: -50, ease: "none", duration: i ? 60 : 40, repeat: -1 });
        t.style.animation = "none";
        ScrollTrigger.create({ onUpdate: (s) => gsap.to(tw, { timeScale: 1 + Math.abs(s.getVelocity()) / 300, duration: 0.2, overwrite: true, onComplete: () => gsap.to(tw, { timeScale: 1, duration: 1 }) }) });
        if (fine) t.parentElement!.addEventListener("mouseenter", () => gsap.to(tw, { timeScale: 0, duration: 0.4 }));
        if (fine) t.parentElement!.addEventListener("mouseleave", () => gsap.to(tw, { timeScale: 1, duration: 0.4 }));
      });

      // boutons magnétiques
      (fine ? document.querySelectorAll<HTMLElement>(".btn") : []).forEach((b) => {
        const mx = gsap.quickTo(b, "x", { duration: 0.4, ease: "power3" }), my = gsap.quickTo(b, "y", { duration: 0.4, ease: "power3" });
        b.addEventListener("mousemove", (e) => { const r = b.getBoundingClientRect(); mx((e.clientX - r.left - r.width / 2) * 0.35); my((e.clientY - r.top - r.height / 2) * 0.35); });
        b.addEventListener("mouseleave", () => { mx(0); my(0); });
      });

      // inclinaison 3D des cartes
      (fine ? document.querySelectorAll<HTMLElement>(".card") : []).forEach((c) => {
        c.addEventListener("mousemove", (e) => { const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
          gsap.to(c, { rotateY: x * 10, rotateX: -y * 10, transformPerspective: 800, duration: 0.4, overwrite: "auto" }); });
        c.addEventListener("mouseleave", () => gsap.to(c, { rotateX: 0, rotateY: 0, duration: 0.6 }));
      });

      // curseur suiveur
      const cx = gsap.quickTo("#cur", "x", { duration: 0.25 }), cy = gsap.quickTo("#cur", "y", { duration: 0.25 });
      addEventListener("mousemove", (e) => { cx(e.clientX); cy(e.clientY); });
      document.querySelectorAll("a,button,.sv").forEach((el) => {
        el.addEventListener("mouseenter", () => gsap.to("#cur", { scale: 3, duration: 0.3 }));
        el.addEventListener("mouseleave", () => gsap.to("#cur", { scale: 1, duration: 0.3 }));
      });

      addEventListener("load", () => ScrollTrigger.refresh());

      // les filtres changent la hauteur de la page
      document.querySelector(".filters")!.addEventListener("click", () => setTimeout(() => {
        ScrollTrigger.refresh();
        gsap.fromTo(".card:not([hidden])", { y: 30, autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.06, duration: 0.5, overwrite: true });
      }, 20));
    }
  </script>

  <script define:vars={{ email: me.email }}>
    // project filters + "voir tout"
    let all = false, f = "all";
    const cards = [...document.querySelectorAll(".card")];
    const apply = () => cards.forEach((c) => (c.hidden = (f !== "all" && c.dataset.k !== f) || (!all && c.dataset.extra === "1")));
    document.querySelectorAll(".filters button[data-f]").forEach((b) => b.addEventListener("click", () => {
      f = b.dataset.f; document.querySelectorAll(".filters button[data-f]").forEach((x) => x.classList.toggle("on", x === b)); apply();
    }));
    document.getElementById("more").addEventListener("click", (e) => { all = !all; e.target.textContent = all ? "Voir moins" : e.target.textContent; apply(); });
    apply();

    // formulaire: pas de backend (site statique), on ouvre le mail pré-rempli
    document.getElementById("form").addEventListener("submit", (e) => {
      e.preventDefault();
      const d = new FormData(e.target), status = document.getElementById("status");
      const body = `Nom: ${d.get("nom")}
Email: ${d.get("email")}
Projet: ${d.get("type")}

${d.get("msg")}`;
      location.href = `mailto:${email}?subject=${encodeURIComponent("Contact portfolio — " + d.get("type"))}&body=${encodeURIComponent(body)}`;
      status.textContent = `Ton application mail va s'ouvrir. Sinon, écris-moi directement à ${email}.`;
    });
  </script>
</body>
</html>
